@{
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}


<!DOCTYPE html>
<html lang="ru" class="h-screen overflow-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Реестр</title>
    <script src="~/js/tailwind.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseSchema.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>

<body class="h-screen overflow-hidden bg-gray-50 bg-[url('/bg.webp')] bg-repeat bg-[length:200px_200px] bg-opacity-[0.03] text-gray-950 min-h-screen flex flex-col">

    <script>
            (function () {
                const savedTheme = localStorage.getItem("theme_mode");
                const currentHour = new Date().getHours();

                if (savedTheme === "dark" || (!savedTheme && (currentHour >= 18 || currentHour < 6))) {
                    document.body.classList.add('dark-mode');
                } else {
                    document.body.classList.remove('dark-mode');
                }
            })();
    </script>

    <header class="sticky top-0 z-50 bg-white/70 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 transition-colors duration-300">
        <div class="w-full px-4 h-16 flex items-center justify-between">


            <div onclick="window.location.href = './Index';" class="cursor-pointer flex items-center space-x-3">
                <img src="~/logo.png" asp-append-version="true" class="w-[35px]" alt="Stek Labs" />


                <span class="text-xl font-bold tracking-tight text-indigo-600 sm:block hidden">Stek Labs</span>
                <span class="text-2xl font-bold tracking-tight text-indigo-600 block sm:hidden">S L</span>
                <span class="text-gray-300 dark:text-gray-600 hidden md:inline-block">|</span>
                <span class="text-sm font-medium text-gray-500 hidden md:inline-block">Инфраструктура</span>
            </div>

            
<div class="flex items-center space-x-3 flex-shrink-0">

    <div class="hidden md:flex items-center space-x-4">
        
        <button type="button" id="theme-toggle-btn" onclick="toggleDarkMode()" title="Переключить режим" class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border border-gray-300 dark:border-gray-600 bg-gray-200 dark:bg-gray-700 transition-colors duration-200 ease-in-out focus:outline-none">
            <div id="theme-toggle-ball" class="pointer-events-none flex items-center justify-center h-5 w-5 transform rounded-full bg-white shadow transition duration-200 ease-in-out translate-x-0.5 mt-[1px] text-[10px]">☀️</div>
        </button>
        <script>
            (function () {
                const savedTheme = localStorage.getItem("theme_mode");
                const currentHour = new Date().getHours();
                if (savedTheme === "dark" || (!savedTheme && (currentHour >= 18 || currentHour < 6))) {
                    document.getElementById("theme-toggle-btn").classList.add("bg-indigo-500");
                    const ball = document.getElementById("theme-toggle-ball");
                    ball.classList.add("translate-x-5");
                    ball.textContent = "🌙";
                } else {
                    document.getElementById("theme-toggle-ball").textContent = "☀️";
                }
            })();
        </script>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <form method="post" asp-page="/Index" asp-page-handler="Logout" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center space-x-1.5 text-xs font-medium text-gray-500 hover:text-red-600 transition-colors p-1.5 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    <span>Выйти</span>
                </button>
            </form>
        }
    </div>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        
                        <button type="button" onclick="toggleMobileMenu()" class="block md:hidden text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 focus:outline-none p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800" title="Открыть меню">
                            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
                            </svg>
                        </button>
                    }
                </div>

        </div>
    </header>

