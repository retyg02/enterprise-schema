@page
@model EnterpriseSchema.Pages.EnterpriseDetailsModel
@{
	ViewData["Title"] = "Детали предприятия";
}
<div class="container mx-auto px-4 py-8">
    
    <div class="mb-6">
        <a asp-page="/Index" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors">
            ← Назад
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
            <div>
                <h1 class="text-3xl font-bold text-gray-900 mt-1">@Model.Enterprise.Name</h1>
                <p class="text-sm text-gray-500 mt-2">📍 <span class="text-gray-800 font-medium">@Model.Enterprise.City</span></p>
            </div>
            <div class="mt-4 md:mt-0 bg-gray-50 border border-gray-200 rounded-lg p-4 max-w-md">
                <span class="text-xs font-medium text-gray-400 block mb-1">👤 Контакт:</span>
                <span class="text-sm text-gray-800 font-semibold">@Model.Enterprise.Contact</span>
            </div>
        </div>
        
        <div class="mt-6 pt-6 border-t border-gray-100">
            <span class="text-xs font-medium text-gray-400 block mb-1">📝 Заметки:</span>
            <p class="text-sm text-gray-700 italic bg-gray-50 p-3 rounded-lg border border-gray-100">@Model.Enterprise.Note</p>
        </div>
    </div>

    <div class="mb-8">
        <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
            🌐 Доступы 
        </h2>
        <div class="flex flex-col space-y-3">
            @if (Model.Enterprise.Accesses != null && Model.Enterprise.Accesses.Any())
            {
                @foreach (var access in Model.Enterprise.Accesses)
                {
                    <div class="bg-white p-4 rounded-xl border border-gray-200 flex flex-wrap justify-between items-center shadow-sm">
                        <div class="flex items-center space-x-4">
                            <span class="px-2.5 py-1 rounded-md text-xs font-bold uppercase bg-blue-100 text-blue-800">@access.Type</span>
                            <span class="text-sm font-mono text-gray-700">@access.Address : @access.Port</span>
                        </div>
                        <div class="flex space-x-6 text-sm mt-2 sm:mt-0">
                            <div><span class="text-gray-400">Логин:</span> <span class="font-medium text-gray-800">@access.Login</span></div>
                            <div><span class="text-gray-400">Пароль:</span> <span class="font-mono bg-gray-100 px-1.5 py-0.5 rounded text-red-600">@access.Pass</span></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-sm text-gray-400 italic pl-2">Здесь ничего нет</p>
            }
        </div>
    </div>

    <div>
        <h2 class="text-xl font-bold text-gray-900 mb-4">🖥️ Хосты</h2>

        <div class="flex flex-col space-y-6">
            @if (Model.Enterprise.Hosts != null && Model.Enterprise.Hosts.Any())
            {
                @foreach (var host in Model.Enterprise.Hosts)
                {
                    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6">

                        <div class="flex flex-wrap justify-between items-start border-b border-gray-100 pb-4 mb-4">
                            <div>
                                <h3 class="text-lg font-bold text-indigo-900">@host.Name</h3>
                                <div class="flex items-center space-x-3 mt-1 text-xs text-gray-500">
                                    <span>⚙️ ОС: <strong class="text-gray-700">@host.Os</strong></span>
                                    <span>•</span>
                                    <span>Назначение: <strong class="text-gray-700">@host.Target</strong></span>
                                </div>
                            </div>
                            <div class="mt-2 sm:mt-0 text-right">
                                <span class="text-xs text-gray-400 block">IP:</span>
                                <span class="text-sm font-mono font-bold text-gray-900 bg-gray-50 px-2 py-1 rounded border border-gray-100">@host.Ip</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Сетевые интерфейсы (ifconfig):</span>
                            <pre class="bg-gray-900 text-green-400 p-3 rounded-lg text-xs font-mono overflow-x-auto whitespace-pre-wrap">@host.NetworkInterfaces</pre>
                        </div>

                        <div class="mb-4 bg-gray-50 border border-gray-200 rounded-lg p-3 text-xs flex flex-col space-y-1">
                            <span class="text-gray-400 font-semibold uppercase tracking-wider text-[10px]">Развернутые службы и пути:</span>
                            <p class="text-gray-800 font-mono whitespace-pre-line">@host.ServicesInfo</p>
                        </div>

                        @if (!string.IsNullOrEmpty(host.Notes))
                        {
                            <div class="mb-4 border-l-4 border-amber-500 bg-amber-50 p-3 rounded-r-lg text-xs">
                                <span class="font-semibold text-amber-800 block mb-1">💡 Свободное поле:</span>
                                <p class="text-amber-900 italic">@host.Notes</p>
                            </div>
                        }

                        <div class="mt-6 pt-4 border-t border-gray-100">
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-3">Доступы к хосту:</span>
                            <div class="flex flex-col space-y-2">
                                @if (host.Accesses != null && host.Accesses.Any())
                                {
                                    @foreach (var acc in host.Accesses)
                                    {
                                        <div class="bg-gray-50 p-3 rounded-lg border border-gray-100 flex flex-col space-y-2 text-xs">
                                            <div class="flex flex-wrap justify-between items-center">
                                                <div class="flex items-center space-x-3">
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-gray-200 text-gray-700">@acc.Type</span>
                                                    <span class="font-mono text-gray-600">@acc.Address:@acc.Port</span>
                                                </div>
                                                <div class="flex space-x-4 mt-1 sm:mt-0">
                                                    <div><span class="text-gray-400">Логин:</span> <span class="font-medium text-gray-800">@acc.Login</span></div>
                                                    <div><span class="text-gray-400">Пароль:</span> <span class="font-mono text-red-600 bg-white px-1 border border-gray-200 rounded">@acc.Pass</span></div>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(acc.ConfigContent))
                                            {
                                                <div class="mt-2 pt-2 border-t border-gray-200/60">
                                                    <span class="text-[10px] font-semibold text-gray-400 uppercase block mb-1">Инструкция:</span>
                                                    <pre class="bg-white p-2 rounded border border-gray-200 text-[11px] font-mono text-gray-600 overflow-x-auto whitespace-pre-wrap">@acc.ConfigContent</pre>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-xs text-gray-400 italic">Здесь пусто</p>
                                }
                            </div>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-center py-8 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                    <p class="text-sm text-gray-500 italic">Здесь не зарегистрировано ни одного хоста.</p>
                </div>
            }
        </div>
    </div>


</div>
