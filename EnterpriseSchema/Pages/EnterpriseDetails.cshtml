<div id="accessTypeModal" class="hidden fixed inset-0 bg-gray-950/20 backdrop-blur-xs items-center justify-center z-50 p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-5 max-w-xs w-full relative transition-transform duration-300 scale-95">
        <h4 class="text-sm font-bold text-gray-900 mb-3">Новый тип доступа</h4>
        <form method="post" id="ajaxAccessTypeForm" onsubmit="submitAccessTypeForm(event)">
            <input type="text" id="accessTypeNameInput" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none mb-3" placeholder="Например, RDP / HTTP" />
            <div class="flex space-x-2">
                <button type="button" onclick="closeModal('accessTypeModal')" class="w-1/2 bg-gray-50 hover:bg-gray-100 text-gray-600 text-xs py-2 rounded-lg transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs py-2 rounded-lg shadow-sm transition-colors">Добавить</button>
            </div>
        </form>
    </div>
</div>












<div id="updateHostModal" onclick="checkOverlayClose(event, 'updateHostModal', true)" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm items-end md:items-center justify-center z-50 transition-opacity duration-300 p-0 md:p-4 opacity-0">
    <div class="bg-white rounded-t-2xl md:rounded-xl shadow-xl border border-gray-200 p-6 max-w-md w-full relative transition-transform duration-300 translate-y-full md:scale-95 max-h-[92vh] overflow-y-auto">
        
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto mb-4 md:hidden"></div>
        <button type="button" onclick="closeModal('updateHostModal', true)" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg focus:outline-none">&times;</button>
        
        <h3 class="text-base font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Редактировать сервер</h3>

        <form id="ajaxUpdateHostForm" method="post" onsubmit="submitUpdateHostForm(event)" class="space-y-3 text-xs">
            <div id="updateHostErrorSummary" class="hidden text-red-600 font-semibold bg-red-50 p-3 rounded-lg mb-3 border border-red-100"></div>

            <input type="hidden" id="updateHostId" />

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Имя хоста</label>
                <input type="text" id="updateHostName" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">IP-адрес</label>
                <input type="text" id="updateHostIp" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Назначение (Purpose)</label>
                <input type="text" id="updateHostPurpose" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div class="grid grid-cols-3 gap-2">
                <div>
                    <label class="block font-semibold text-gray-500 uppercase mb-1">Имя ОС</label>
                    <input type="text" id="updateHostOsName" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block font-semibold text-gray-500 uppercase mb-1">Версия</label>
                    <input type="text" id="updateHostOsVer" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block font-semibold text-gray-500 uppercase mb-1">Архит.</label>
                    <input type="text" id="updateHostOsType" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                </div>
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Сетевые интерфейсы</label>
                <textarea id="updateHostNetInterfaces" rows="2" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Заметки</label>
                <input type="text" id="updateHostNotes" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div class="pt-3 border-t border-gray-100 space-y-3">
                <div class="flex justify-between items-stretch md:items-center">
                    <span class="font-semibold text-gray-500 uppercase tracking-wider">Развернутые службы</span>
                    <button type="button" onclick="openServiceModal()" class="bg-gray-100 hover:bg-gray-200 border border-gray-300 text-gray-700 px-2 py-1 rounded-md text-[10px] font-bold focus:outline-none transition-colors">
                        + Добавить службу
                    </button>
                </div>
    
    
                <div id="addedServicesList" class="space-y-1.5 max-h-32 overflow-y-auto pr-1"></div>
            </div>

            <div class="pt-2 flex space-x-3 text-sm">
                <button type="button" onclick="clearHostFormAdditions()" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 rounded-lg transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg shadow-sm transition-colors">Сохранить</button>
            </div>
        </form>
    </div>
</div>






<div id="serviceModal" class="hidden fixed inset-0 bg-gray-950/20 backdrop-blur-xs items-center justify-center z-50 p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-5 max-w-xs w-full relative transition-transform duration-300 scale-95 text-xs">
        <h4 class="text-sm font-bold text-gray-900 mb-3">Новая служба хоста</h4>
        <form id="ajaxServiceForm" method="post" onsubmit="submitServiceForm(event)" class="space-y-3">
            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-0.5">Название службы</label>
                <input type="text" id="serviceNameInput" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="например, PostgreSQL" />
            </div>
            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-0.5">Описание</label>
                <input type="text" id="serviceDescInput" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Основная БД данных" />
            </div>
            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-0.5">Физический путь (Path)</label>
                <input type="text" id="servicePathInput" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-1.5 font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="/var/lib/postgresql" />
            </div>
            
            <div class="flex space-x-2 pt-1">
                <button type="button" onclick="closeModal('serviceModal')" class="w-1/2 bg-gray-50 hover:bg-gray-100 text-gray-600 py-2 rounded-lg transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg shadow-sm transition-colors">Добавить</button>
            </div>
        </form>
    </div>
</div>




