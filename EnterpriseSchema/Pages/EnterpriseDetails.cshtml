                </div>
            </div>


            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Примечание / Инструкция (Необязательно)</label>
                <input type="text" id="accessNote" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Например, доступ только по ключу..." />
            </div>

            <div class="pt-2 flex space-x-3 text-sm">
                <button type="button" onclick="closeModal('createAccessModal', true)" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 rounded-lg transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg shadow-sm transition-colors">Сохранить</button>
