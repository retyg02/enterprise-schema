@page
@model EnterpriseSchema.Pages.EnterpriseDetailsModel
@using System.Text.Encodings.Web
@{
	ViewData["Title"] = "Детали предприятия";
}
<div class="container mx-auto max-w-7xl px-6 lg:px-8 py-8">
    
    <div class="mb-6">
        <a asp-page="/Index" class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-800 transition-colors">
            ← Назад
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
            <div>
                <div class="text-3xl font-bold text-gray-900 mt-1 flex flex-row">
                    @Model.Enterprise?.Name
                    <button type="button" id="paranoia-toggle-btn" onclick="toggleParanoiaMode()" title="Блюр" class="relative top-[2px] flex items-center justify-center p-2 text-gray-400 hover:text-emerald-500 rounded-lg transition-all duration-300 cursor-pointer focus:outline-none">
                        <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 transition-transform duration-300">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.644M21.964 12.322a1.012 1.012 0 010-.644M5.93 5.93l1.242 1.242M16.828 16.828l1.242 1.242M18.07 5.93l-1.242 1.242M7.172 16.828L5.93 18.07" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                        </svg>
                    </button>

                </div>
                <p class="text-sm text-gray-500 mt-2">📍 <span class="text-gray-800 font-medium">@Model.Enterprise?.City?.Name</span></p>
                <p class="text-sm text-gray-500 mt-2">📅 <span class="text-gray-800 font-medium">@Model.Enterprise?.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span></p>
            </div>
            <div id="contact-section" class="mt-4 md:mt-0 bg-gray-50 border border-gray-200 rounded-lg p-4 max-w-md">
                <span class="text-xs font-medium text-gray-400 block mb-1">👤 Контакт:</span>
                <span class="text-sm text-gray-800 font-semibold">@Model.Enterprise?.Contact</span>
            </div>
        </div>
        
        <div id="notes-section" class="mt-6 pt-6 border-t border-gray-100">
            <span class="text-xs font-medium text-gray-400 block mb-1">📝 Заметки:</span>
            <p class="access-item-card text-sm text-gray-700 italic bg-gray-50 p-3 rounded-lg border border-gray-100">@Model.Enterprise?.Note</p>
        </div>
    </div>

   <!--тут были доступы напрямую у предприятия-->

    <div>
        <div class="flex md:flex-row md:items-center justify-between mb-4 flex-col">
        <h2 class="text-xl font-bold text-gray-900 flex flex-row row items-center">
            🖥️ Хосты
            <span id="hostsCounter" class="ml-[10px] relative top-[2px] bg-gray-100 text-gray-700 text-xs font-bold px-2.5 py-1 rounded-full border border-gray-200">
                @Model.Enterprise?.Hosts?.Count
            </span>
        </h2>
        <div class="relative flex flex-row mt-[10px] md:mt-auto">

            
            <div class="relative w-full md:w-auto mr-[5px]">
            <input type="text" id="hostSearchInput" oninput="filterHosts()" placeholder="Поиск по имени, службам, кредам..."
                   class="md:mt-auto w-full bg-white border border-gray-300 rounded-lg pl-9 pr-8 py-1.5 text-xs text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all placeholder-gray-400 shadow-sm" />
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            </div>
            
            <button type="button" id="clearHostSearchBtn" onclick="clearHostSearch()" class="hidden absolute inset-y-0 right-0 pr-2.5 flex items-center text-gray-400 hover:text-gray-600 transition-colors">
                <svg xmlns="http://w3.org" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <button type="button" onclick="openModal('createHostModal')" class="w-full md:w-auto bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-1.5 px-3 rounded-lg text-xs shadow-sm transition-colors focus:outline-none">
                + Добавить хост
            </button>
        </div>
        </div>

        <div class="flex flex-col space-y-6">
            @if (Model.Enterprise?.Hosts != null && Model.Enterprise.Hosts.Any())
            {
                @foreach (var host in Model.Enterprise.Hosts)
                {
                    <div id="host-card-@host.Id" class="host-card bg-white border border-gray-200 rounded-xl shadow-sm p-6">

                        <div class="flex flex-wrap justify-between items-start border-b border-gray-100 pb-4 mb-4">
                            <div>
                                
                                
                                
                                
                                <h3 class="mb-[20px] text-lg font-bold text-indigo-900 flex flex-row items-center">
                                    @host.Name
                                    <form method="post" onsubmit="submitDeleteHost(event, @host.Id, '@host.Name')" class="inline">
                                        <button type="submit" class="relative top-[2px] left-[5px] text-gray-400 hover:text-red-600 transition-colors p-1 rounded-md hover:bg-red-50 focus:outline-none" title="Удалить сервер">
                                            <svg xmlns="http://w3.org" class="h-4 w-4 hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </form>

                                    <button type="button" onclick="openUpdateHostModal(@host.Id, '@host.Name', '@host.Ip', '@host.Purpose', '@host.OsName', '@host.OsVer', '@host.OsType', '@JavaScriptEncoder.Default.Encode(host.NetworkInterfaces)', '@host.Notes')" class="ml-[5px] relative top-[1px] text-gray-400 hover:text-indigo-600 transition-colors p-1 rounded-md hover:bg-indigo-50 focus:outline-none mr-1" title="Редактировать сервер">
                                        <svg xmlns="http://w3.org" class="h-4 w-4 hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>

                                </h3>

                                


                                <div class="flex items-center space-x-3 mt-1 text-xs text-gray-500">
                                    
                                    <div class="flex flex-wrap gap-2 items-center text-xs font-mono">
                                        <span class="text-gray-500 font-sans text-sm">ОС:</span>
                                        <span class="host-badge-item secret-data bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded border border-indigo-100 font-bold">
                                            @host.OsName
                                        </span>
                                        <span class="host-badge-item secret-data bg-gray-100 text-gray-800 px-2 py-0.5 rounded border border-gray-200">
                                            @host.OsVer
                                        </span>
                                        <span class="host-badge-item secret-data bg-amber-50 text-amber-800 px-2 py-0.5 rounded border border-amber-200 text-[11px] uppercase tracking-wider font-semibold">
                                            @host.OsType
                                        </span>
                                    </div>

                                    <span>•</span>
                                    <span>Назначение: <strong class="secret-data text-gray-700"><span class="host-purpose-text">@host.Purpose</span></strong></span>
                                    <span>•</span>
                                    <span>Создан: @host.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>
                            <div class="host-ip-badge mt-2 sm:mt-0 text-right">
                                
                                <span class="access-item-card secret-data text-sm font-mono font-bold text-gray-900 bg-gray-50 px-2 py-1 rounded border border-gray-100">IP: @host.Ip</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-1">Сетевые интерфейсы (ifconfig):</span>
                            <pre class="secret-data bg-gray-900 text-green-400 p-3 rounded-lg text-xs font-mono overflow-x-auto whitespace-pre-wrap">@host.NetworkInterfaces</pre>
                        </div>

                        <div class="access-item-card mb-4 bg-gray-50 border border-gray-200 rounded-lg p-3 text-xs flex flex-col space-y-3">
                            
                            
                            <span class="text-gray-400 font-semibold uppercase block mb-1">
                                

                                Развернутые службы и пути:
                            </span>

                            @if (host.Services != null && host.Services.Any())
                            {
                                @foreach (var service in host.Services)
                                {
                                    <div id="service-card-@service.Id service_section" class="service-row-item border-b border-gray-200 last:border-0 pb-2 last:pb-0 flex flex-col space-y-1">
                                        <div class="secret-data flex flex-row items-center justify-start text-gray-900 font-bold">
                                            
                                            ● @service.Name
                                            <form method="post" onsubmit="submitDeleteService(event, @service.Id, '@service.Name')" class="relative bottom-[1px] inline">
                                                <button type="submit" class="relative top-[2px] left-[5px] text-gray-400 hover:text-red-600 transition-colors p-1 rounded-md hover:bg-red-50 focus:outline-none" title="Удалить сервер">
                                                    <svg xmlns="http://w3.org" class="h-4 w-4 hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                        <p class="secret-data text-gray-600 italic pl-3">@service.Description</p>
                                        <pre class="service-path-card secret-data bg-white p-2 rounded border border-gray-100 font-mono text-indigo-600 overflow-x-auto whitespace-pre-wrap mt-1 ml-3">Путь: @service.Path</pre>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-gray-400 italic">Службы не зарегистрированы</p>
                            }
                        </div>


                        @if (!string.IsNullOrEmpty(host.Notes))
                        {
                            <div id="warning-note-box" class="mb-4 border-l-4 border-amber-500 bg-amber-50 p-3 rounded-r-lg text-xs">
                                <span class="font-semibold text-amber-800 block mb-1">💡 Свободное поле:</span>
                                <p class="secret-data text-amber-900 italic">@host.Notes</p>
                            </div>
                        }

                        <div id="access-control-section" class="mt-6 pt-4 border-t border-gray-100">
                            <div class="flex flex-row justify-between items-center text-xs font-semibold text-gray-400 uppercase tracking-wider block mb-3">
                                <span>Доступы к хосту:</span>
                                <button type="button" onclick="openCreateAccessModal(@host.Id)" class="cursor-pointer text-indigo-600 hover:text-indigo-800 text-xs font-semibold flex items-center focus:outline-none">
                                    + Добавить доступы
                                </button>
                            </div>
                            <div class="flex flex-col space-y-2">
                                @if (host.Accesses != null && host.Accesses.Any())
                                {
                                    @foreach (var acc in host.Accesses)
                                    {
                                        <div class="access-item-card bg-gray-50 p-3 rounded-lg border border-gray-100 flex flex-col space-y-2 text-xs">
                                            <div class="flex flex-wrap justify-between items-center">
                                                <div class="flex items-center space-x-3">

                                                    <form method="post" onsubmit="submitDeleteAccess(event, @acc.Id, '@acc.Login', @host.Id)" class="inline">
                                                        <button type="submit" class="text-gray-400 hover:text-red-600 transition-colors p-1 rounded hover:bg-red-50 focus:outline-none" title="Удалить параметры доступа">
                                                            <svg xmlns="http://w3.org" class="h-3.5 w-3.5 hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                            </svg>
                                                        </button>
                                                    </form>

                                                    <span class="service-type-badge secret-data px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-gray-200 text-gray-700">@acc.AccessType?.Name</span>
                                                    <span class="secret-data font-mono text-gray-600">@acc.Address:@acc.Port</span>
                                                </div>


                                                


                                                <div class="flex space-x-4 mt-1 sm:mt-0">
                                                    <div>
                                                        <span class="text-gray-400">Логин:</span> 
                                                        <span class="font-medium text-gray-800">
                                                            <span onclick="copyToClipboard(this, '@acc.Login')" class="secret-data text-gray-900 font-bold cursor-pointer hover:text-indigo-600 transition-colors" title="Нажмите, чтобы скопировать">
                                                                @acc.Login
                                                            </span>
                                                        </span>
                                                    </div>
                                                    <div>
                                                        <span class="text-gray-400">Пароль:</span> 
                                                        <span id="pass-text-@acc.Id" onclick="copyToClipboard(this, '@EnterpriseSchema.Data.CryptoHelper.Decrypt(acc.Pass)')" 
                                                            class="secret-data text-gray-900 font-bold cursor-pointer hover:text-indigo-600 transition-colors font-sans" title="Нажмите, чтобы скопировать">
                                                            ••••••••
                                                        </span>
                                                    </div>
                                                    <button type="button" onclick="togglePassword(@acc.Id, '@EnterpriseSchema.Data.CryptoHelper.Decrypt(acc.Pass)')" class="text-gray-400 hover:text-gray-600 p-0.5 focus:outline-none" title="Показать/Скрыть пароль">
                                                        <svg xmlns="http://w3.org" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="eye-icon-@acc.Id">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                        </svg>
                                                    </button>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(acc.Note))
                                            {
                                                <div class="mt-2 pt-2 border-t border-gray-200/60">
                                                    <span class="text-[10px] font-semibold text-gray-400 uppercase block mb-1">Инструкция:</span>
                                                    <pre class="service-desc-box secret-data bg-white p-2 rounded border border-gray-200 text-[11px] font-mono text-gray-600 overflow-x-auto whitespace-pre-wrap">@acc.Note</pre>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-xs text-gray-400 italic">Здесь пусто</p>
                                }
                            </div>
                        </div>

                    </div>
                }
            }
            else
            {
                <div class="access-item-card text-center py-8 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                    <p class="text-sm text-gray-500 italic">Здесь не зарегистрировано ни одного хоста.</p>
                </div>
            }
        </div>
    </div>


</div>






<div id="createHostModal" onclick="checkOverlayClose(event, 'createHostModal')" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm items-end md:items-center justify-center z-50 transition-opacity duration-300 p-0 md:p-4 opacity-0">
    <div class="bg-white rounded-t-2xl md:rounded-xl shadow-xl border border-gray-200 p-6 max-w-md w-full relative transition-transform duration-300 translate-y-full md:scale-95 max-h-[92vh] overflow-y-auto">
        
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto mb-4 md:hidden"></div>
        <button type="button" onclick="closeModal('createHostModal', true)" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg focus:outline-none">&times;</button>
        
        <h3 class="text-base font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Новый Хост</h3>

        <form method="post" id="ajaxHostForm" onsubmit="submitHostForm(event)" class="space-y-3 text-xs">
            
            <div id="hostErrorSummary" class="hidden text-red-600 font-semibold bg-red-50 p-3 rounded-lg mb-3 border border-red-100"></div>

            <input type="hidden" id="hostEnterpriseId" value="@Model.Enterprise?.Id" />

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Имя хоста</label>
                <input type="text" id="hostName" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="например, server-docker-01" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">IP-адрес IPv4</label>
                <input type="text" id="hostIp" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="192.168.1.50" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Назначение (Purpose)</label>
                <input type="text" id="hostPurpose" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="СЦ / ВС / Свободное назначение" />
            </div>

            


            <div class="grid grid-cols-3 gap-2">
                <div>
                    <label class="block font-semibold text-gray-500 uppercase mb-1">Имя ОС</label>
                    <input type="text" id="hostOsName" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Ubuntu" />
                </div>
                <div>
                    <label class="block font-semibold text-gray-500 uppercase mb-1">Версия</label>
                    <input type="text" id="hostOsVer" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="24" />
                </div>
                <div>
                    <label class="block font-semibold text-gray-500 uppercase mb-1">Тип</label>
                    <input type="text" id="hostOsType" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-2 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="04" />
                </div>
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Сетевые интерфейсы (ifconfig)</label>
                <textarea id="hostNetInterfaces" rows="2" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 font-mono focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="eth0: flags=4163<UP,BROADCAST,RUNNING>..."></textarea>
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Заметки (Необязательно)</label>
                <input type="text" id="hostNotes" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Комментарий к серверу..." />
            </div>

            <div class="pt-2 flex space-x-3 text-sm">
                <button type="button" onclick="closeModal('createHostModal', true)" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 rounded-lg transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg shadow-sm transition-colors">Создать</button>
            </div>
        </form>
    </div>
</div>







<div id="createAccessModal" onclick="checkOverlayClose(event, 'createAccessModal', true)" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm items-end md:items-center justify-center z-50 transition-opacity duration-300 p-0 md:p-4 opacity-0">
    <div class="bg-white rounded-t-2xl md:rounded-xl shadow-xl border border-gray-200 p-6 max-w-md w-full relative transition-transform duration-300 translate-y-full md:scale-95 max-h-[92vh] overflow-y-auto">
        
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto mb-4 md:hidden"></div>
        <button type="button" onclick="closeModal('createAccessModal', true)" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg focus:outline-none">&times;</button>
        
        <h3 class="text-base font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Новый доступ к хосту</h3>

        <form method="post" id="ajaxAccessForm" onsubmit="submitAccessForm(event)" class="space-y-3 text-xs">
            <div id="accessErrorSummary" class="hidden text-red-600 font-semibold bg-red-50 p-3 rounded-lg mb-3 border border-red-100"></div>

            <input type="hidden" id="accessHostId" />

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Тип доступа (Справочник)</label>
                <div class="flex space-x-2">
                    <select id="accessAccessTypeId" asp-items="Model.AccessTypeList" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                        <option value="">-- Выберите тип (SSH/DB/VPN) --</option>
                    </select>
                    <button type="button" onclick="openModal('accessTypeModal')" class="bg-gray-100 hover:bg-gray-200 border border-gray-300 text-gray-700 px-3 rounded-lg text-sm focus:outline-none transition-colors" title="Добавить новый тип доступа">+</button>
                </div>

            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Сетевой адрес (IP или домен)</label>
                <input type="text" id="accessAddress" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="192.168.0.10" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Порт подключения</label>
                <input type="number" id="accessPort" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="22" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Логин</label>
                <input type="text" id="accessLogin" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="root" />
            </div>

            <div>
                <label class="block font-semibold text-gray-500 uppercase mb-1">Пароль</label>
                <div class="relative w-full">
                    <input placeholder="password" type="text" id="accessPass" required class="w-full bg-gray-50 border border-gray-300 rounded-lg pl-3 pr-10 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none transition-all duration-300" />
        
                    <button type="button" onclick="generateSecurePassword()" title="Сгенерировать" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-emerald-500 transition-colors duration-300 p-0.5 rounded cursor-pointer focus:outline-none">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" fill="currentColor" class="w-4 h-4">
