@page "/Accesses"
@model EnterpriseSchema.Pages.AccessesModel
@{
    ViewData["Title"] = "Доступы";
}




@Html.AntiForgeryToken()
<div class="space-y-5 select-none transition-colors duration-200">

    <div class="space-y-1">
        <div class="flex items-center space-x-3">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
                Подключения
            </h1>
            <span id="universal-counter-badge"
                  class="inline-flex items-center justify-center px-2.5 py-1 text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 rounded-full border border-indigo-100 dark:border-indigo-900/20">
                @Model.AccessesList.Count
            </span>
        </div>
        <p class="text-sm text-slate-500 dark:text-slate-400">
            Список всех доступов всех хостов всех предприятий
        </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-4 bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm w-full">
        <div class="relative flex-grow w-full">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
                <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.602 10.602Z" />
                </svg>
            </div>

            <input type="text"
                   id="universal-search-input"
                   placeholder="Быстрый поиск по подключениям..."
                   class="w-full pl-9 pr-12 py-2 bg-slate-50 focus:bg-white dark:bg-slate-950 dark:focus:bg-slate-950 border border-slate-200 focus:border-indigo-500 dark:border-slate-800 dark:focus:border-indigo-500 rounded-lg text-sm text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all" />

            <div id="universal-kbd-shortcut" class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none transition-opacity duration-150">
                <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-medium bg-white dark:bg-slate-900 text-slate-400 dark:text-slate-500 border border-slate-200 dark:border-slate-800 rounded shadow-sm">
                    Ctrl + K
                </kbd>
            </div>

            <button type="button"
                    id="universal-search-clear"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 hidden">
                <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>
</div>

<div class="mb-4"></div>







<div id="logs-main-container" class="bg-white dark:bg-slate-900 rounded-xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden select-none transition-colors duration-200">

    <div id="logs-desktop-header" class="hidden md:grid grid-cols-12 gap-4 bg-slate-50 dark:bg-slate-900/50 text-slate-500 dark:text-slate-400 font-bold text-xs border-b border-slate-100 dark:border-slate-800 uppercase tracking-wider px-6 py-3.5">
        <div class="col-span-2 flex items-center">
            <button type="button"
                    id="accesses-sort-type"
                    class="js-btn-access-sort flex items-center space-x-1 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none transition-colors"
                    data-sort-field="type">
                <span>Тип доступа</span>
                <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 text-slate-300 dark:text-slate-600 transition-all duration-200 sort-arrow-icon">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19.5v-15m0 0-6.75 6.75M12 4.5l6.75 6.75" />
                </svg>
            </button>
        </div>
        <div class="col-span-2">Сокет</div>
        <div class="col-span-2">Логин</div>
        <div class="col-span-3">Пароль</div>
        <div class="col-span-3 text-right">Примечание</div>
    </div>

    <div id="logs-table-body" class="p-3 md:p-0 space-y-3 md:space-y-0 md:divide-y md:divide-slate-100 md:dark:divide-slate-800/60 bg-white dark:bg-slate-900">

        @foreach (var access in Model.AccessesList)
        {
            var socketString = $"{access.Address}:{access.Port}";
            var decryptedPassword = EnterpriseSchema.Data.CryptoHelper.Decrypt(access.Pass);
            var enterpriseName = access.Host?.Enterprise?.Name ?? "Удалено";
            var enterpriseId = access.Host?.EnterpriseId ?? 0;

            <div id="access-card-@access.Id" class="logs-row flex flex-col md:grid md:grid-cols-12 gap-2.5 md:gap-4 px-4 py-4 md:px-6 md:py-4 bg-slate-50/50 dark:bg-slate-900/30 md:bg-transparent md:dark:bg-transparent rounded-xl md:rounded-none border border-slate-100 dark:border-slate-800/80 md:border-none hover:bg-slate-50/80 md:hover:bg-slate-50 dark:hover:bg-slate-900/60 md:dark:hover:bg-slate-900/40 transition-all text-sm items-start md:items-center">

                <div class="w-full md:col-span-2 flex items-center">
                    <span class="md:hidden text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider w-24 flex-shrink-0">Тип:</span>
                    
                    
                    <div class="flex flex-row items-center">
<button type="button" 
        class="relative left-[-5px] p-1.5 text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-all focus:outline-none flex-shrink-0"
        onclick="submitDeleteAccess(event, @access.Id, '@(access.AccessType?.Name ?? "Доступ")')"
        title="Удалить доступ">
    <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
    </svg>
</button>

<span data-copy-green class="log-field-action inline-flex items-center px-2 py-0.5 rounded-md text-xs font-bold bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-900/20 uppercase tracking-wide">
                        @(access.AccessType?.Name ?? "Доступ")
                    </span>

                    </div>
                    
                    
                    
                </div>

                <div class="w-full md:col-span-2 flex items-center">
                    <span class="md:hidden text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider w-24 flex-shrink-0">Адрес:</span>
                    <span data-copy-green class="log-field-phone js-universal-copy cursor-pointer font-mono text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded px-1 transition-all" title="Скопировать сокет">
                        @socketString
                    </span>
                </div>

                <div class="w-full md:col-span-2 flex items-center">
                    <span class="md:hidden text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider w-24 flex-shrink-0">Логин:</span>
                    <span data-copy-green class="log-field-user js-universal-copy cursor-pointer text-slate-900 dark:text-white font-medium hover:bg-indigo-600 hover:text-white rounded px-1.5 transition-all truncate" title="Скопировать логин">
                        @access.Login
                    </span>
                </div>

                <div class="w-full md:col-span-3 flex items-center">
                    <span class="md:hidden text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider w-24 flex-shrink-0">Пароль:</span>
                    <div class="flex items-center space-x-2 font-mono text-xs">

                        <span class="js-password-text cursor-pointer text-slate-800 dark:text-slate-200 font-semibold hover:bg-emerald-500 hover:text-white px-1.5 rounded transition-all select-none"
                              data-copy-pass
                              data-raw-password="@decryptedPassword"
                              title="Нажмите для копирования пароля">••••••••</span>

                        <button type="button"
                                class="js-btn-toggle-password p-1 text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-md transition-all focus:outline-none flex-shrink-0"
                                title="Показать/скрыть пароль">
                            <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 icon-eye-open">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.645C3.752 9.208 7.69 6 12 6c4.31 0 8.356 3.208 10.273 5.677a1.012 1.012 0 0 1 0 .645C20.574 14.792 16.63 18 12 18c-4.31 0-8.356-3.208-10.273-5.677Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            </svg>
                            <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5 icon-eye-closed hidden">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </button>

                    </div>
                </div>


                <div class="w-full md:col-span-3 flex flex-col md:items-end text-left md:text-right">
                    <div class="flex items-center md:justify-end w-full">
                        <span class="md:hidden text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider w-24 flex-shrink-0">Заметка:</span>
                        <span data-copy-green class="log-field-description text-xs text-slate-500 dark:text-slate-400 truncate max-w-[180px] block italic" title="@access.Note">
                            @(string.IsNullOrWhiteSpace(access.Note) ? "—" : access.Note)
                        </span>
                    </div>
                    <div class="flex items-center md:justify-end w-full mt-0.5">
                        <span class="md:hidden text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider w-24 flex-shrink-0">Предприятие:</span>
                        <a href="/EnterpriseDetails?id=@enterpriseId" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300 underline decoration-dotted transition-colors truncate" title="Перейти на страницу предприятия">
                            @enterpriseName
                        </a>
                    </div>
                </div>

            </div>
        }

    </div>
</div>







<div id="logs-no-results" class="hidden flex-col items-center justify-center py-12 text-center select-none transition-colors duration-200">
    <div class="w-12 h-12 rounded-full bg-slate-50 dark:bg-slate-950 text-slate-400 flex items-center justify-center mb-3 animate-bounce">
        <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
        </svg>
    </div>
    <h3 class="text-sm font-semibold text-slate-900 dark:text-white mb-1">Ничего не найдено</h3>
    <p class="text-xs text-slate-400 dark:text-slate-500 max-w-xs px-4">
        Попробуйте изменить поисковый запрос или проверить ключевые слова.
    </p>
</div>




@section Scripts {
    <script src="~/js/accesses.js" asp-append-version="true"></script>
}

