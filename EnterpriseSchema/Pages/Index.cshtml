                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </form>
                            </div>
                            <a data-enterprise-id="@enterprise.Id" data-enterprise-name="@enterprise.Name" asp-page="/EnterpriseDetails" asp-route-id="@enterprise.Id" 
                            class="inline-flex items-center justify-center px-4 py-2 border
                                border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 
                                focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-150">
                                Открыть →
                            </a>
                        </div>

                    </div>
                <div data-enterprise-id="@enterprise.Id" class="row-click-area view-list-row hidden w-full items-center justify-between text-xs py-3.5 bg-transparent border-b border-gray-100 dark:border-gray-800 last:border-b-0 hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors text-gray-900 dark:text-white select-none">
                    <div class="pl-[20px] flex items-center space-x-4 flex-grow min-w-0">
                        
<button type="button" 
        data-enterprise-id="@enterprise.Id" 
        class="relative left-[5px] btn-card-favorite text-gray-400 hover:text-amber-500 dark:hover:text-amber-400 transition-colors flex-shrink-0 @(Model.UserFavoriteEnterpriseIds.Contains(enterprise.Id) ? "is-in-favorite" : "")" 
        title="В избранное">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
