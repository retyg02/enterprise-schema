@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}


<div class="flex items-start w-full relative z-10 transition-all duration-300">

<div class="w-full flex flex-col space-y-6">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-gray-200">
        <div>@Html.AntiForgeryToken()
            <p class="text-2xl font-bold text-gray-900 tracking-tight">
                Реестр развертываний
                <span id="counter-badge" class="relative top-[-2px] ml-1 bg-indigo-50 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-full border border-indigo-100">
                    @Model.Enterprises?.Count
                </span>    
            </p>
            
            <div class="flex flex-wrap items-center gap-x-2 gap-y-2 mt-2 text-xs text-gray-500 dark:text-gray-400 font-medium">
    
    <div class="flex items-center space-x-1.5">
        <span id="stats-count-hosts" class="text-gray-900 dark:text-white font-bold">
            @Model.Enterprises?.Count
        </span>
        <span>предприятий</span>
    </div>

    <span class="text-gray-300 dark:text-gray-700 hidden sm:inline">•</span>

    <div class="flex items-center space-x-1.5">
        <span id="stats-count-hosts" class="text-gray-900 dark:text-white font-bold">
            @Model.HostsModel?.Count
        </span>
        <span>развертываний</span>
    </div>

    <span class="text-gray-300 dark:text-gray-700 hidden sm:inline">•</span>

    <div class="flex items-center space-x-1.5">
        <span id="stats-count-accesses" class="text-gray-900 dark:text-white font-bold">
            @Model.Accesses?.Count
        </span>
        <span>подключений</span>
    </div>
</div>
        </div>

        <button onclick="openModal('createModal')" class="mt-4 md:mt-0 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg text-sm shadow-sm transition-colors focus:outline-none">
            + Предприятие
        </button>
    </div>

    <div id="recent-enterprises-container" class="hidden w-full mx-auto mb-4 text-xs text-gray-500 flex items-center space-x-2">
        <span class="font-medium text-gray-400 flex-shrink-0">Недавние:</span>
        <div id="recent-enterprises-list" class="flex flex-nowrap items-center gap-2 overflow-x-auto w-full py-1" style="-ms-overflow-style: none; scrollbar-width: none;">
            @* недавние предприятия 3 максимум *@
        </div>
    </div>







<div class="w-full flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
    
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-grow max-w-3xl">
        
        <form method="get" asp-page="/Index" class="relative block lg:w-[300px] w-full">
                        
<input id="search-input" type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Поиск предприятия, IP хоста..." 
       class="h-[32px] lg:w-[300px] w-full bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg pl-9 pr-16 py-1.5 text-xs text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none transition-colors" />


<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
</div>


<div id="search-kbd-container" class="absolute inset-y-0 right-1 hidden sm:flex items-center pointer-events-none transition-opacity duration-200">
    <kbd class="inline-flex items-center px-1.5 py-1 rounded text-[10px] font-bold select-none">
        Ctrl + K
    </kbd>
</div>



                        @if (ViewData["CurrentFilter"] != null && !string.IsNullOrWhiteSpace(ViewData["CurrentFilter"]?.ToString()))
                        {
                            <div class="absolute inset-y-0 right-0 pr-2.5 flex items-center">
                                <a href="/Index" class="text-gray-400 hover:text-gray-600 transition-colors" title="Очистить поиск">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </a>
                            </div>
                        }
                    </form>

        <div class="custom-select-container relative w-full sm:w-48 flex-shrink-0">
            <input id="Filter_CityId" type="hidden" name="filterCityId" class="custom-select-value" value="" />
            
            <div class="custom-select-trigger relative w-full bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-800 rounded-lg pl-3 pr-10 py-2 text-xs text-gray-700 dark:text-gray-300 cursor-pointer flex items-center justify-between select-none shadow-sm focus:border-indigo-500">
                <span class="custom-select-text text-gray-400 dark:text-gray-500">Все города</span>
                <svg class="custom-select-arrow w-4 h-4 text-gray-400 transition-transform duration-200" xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
            </div>

            <div id="filter-city-options" class="custom-select-options hidden absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-lg shadow-xl z-50 transition-all duration-200 overflow-hidden">
                <div class="custom-select-option px-4 py-2 text-xs text-gray-400 dark:text-gray-500 cursor-pointer hover:bg-indigo-50 dark:hover:bg-gray-800 transition-colors" data-value="">
                    Все города
                </div>
                @if (Model.CityList != null && Model.CityList.Any())
                {
                    @foreach (var item in Model.CityList)
                    {
                        <div data-value="@item.Value" class="custom-select-option px-4 py-2 text-xs text-gray-700 dark:text-gray-300 hover:bg-indigo-50 dark:hover:bg-gray-800 hover:text-indigo-600 dark:hover:text-white cursor-pointer select-none transition-colors">
                            @item.Text
                        </div>
                    }
                }

                
                </div>
        </div>

        <button type="button" id="filter-favorites-toggle" 
                class="flex items-center justify-center h-8 w-8 rounded-lg border border-gray-300 dark:border-gray-800 bg-white dark:bg-gray-900 text-gray-400 dark:text-gray-500 hover:text-amber-500 dark:hover:text-amber-400 shadow-sm transition-all flex-shrink-0" 
                title="Показать только избранное">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
        </button>

    </div>




           
        
        




<div id="view-mode-toggle-container" class="flex items-center rounded-lg p-0.5 shadow-sm transition-colors duration-300">
    <button type="button" id="view-mode-list" class="p-1.5 rounded-md transition-colors" title="Режим списка">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
    <button type="button" id="view-mode-grid" class="p-1.5 rounded-md is-active-view transition-colors" title="Режим карточек">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zm10 0a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
        </svg>
    </button>
</div>


</div>








<div id="registry-items-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full relative z-10">

<div id="enterprises-table-header" class="hidden w-full items-center text-[10px] font-bold text-gray-400 dark:text-gray-500 tracking-wider px-6 py-2 bg-gray-50 dark:bg-gray-850 border-b border-gray-200 dark:border-gray-800 select-none">
    <div class="w-8 flex-shrink-0"></div> 
    <button type="button" id="sort-by-name" class="w-1/4 min-w-[120px] flex items-center space-x-1 hover:text-indigo-650 dark:hover:text-indigo-400 transition-colors group text-left">
        <span>Предприятие</span>
        <span class="sort-icon text-xs transform transition-transform duration-200">↓</span>
    </button>
    <div class="w-1/5 min-w-[100px]">Развертывания</div>
    <div class="w-1/4 min-w-[130px] relative left-[30px]">Контакт</div>
    
    <button type="button" id="sort-by-date" class="w-1/6 min-w-[80px] flex items-center justify-end space-x-1 hover:text-indigo-650 dark:hover:text-indigo-400 transition-colors group text-right pr-6">
        <span>Обновлено</span>
        <span class="sort-icon text-xs transform transition-transform duration-200">↓</span>
    </button>
    <div class="w-6 flex-shrink-0"></div> 
</div>


    

    @if (Model.Enterprises != null && Model.Enterprises.Any())
    {
        @foreach (var enterprise in Model.Enterprises)
