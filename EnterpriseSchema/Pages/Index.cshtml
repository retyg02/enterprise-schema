    </svg>
</button>


                        
                        <div class="w-1/4 min-w-[120px] flex flex-col">
                            <a href="/EnterpriseDetails?id=@enterprise.Id" class="enterprise-name-text font-bold text-gray-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                                @enterprise.Name
                            </a>
                            <span class="enterprise-city-text text-[11px] text-gray-400 dark:text-gray-500 mt-0.5 flex items-center">
                                <span class="mr-1">
                                    <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-3.5 h-3.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
