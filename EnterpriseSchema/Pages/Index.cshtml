@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container mx-auto max-w-7xl px-6 lg:px-8 py-8">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-gray-200 pb-6 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Реестр развертываний</h1>
            <p class="text-sm text-gray-500 mt-1">
                Список подключенных предприятий
                <span id="counter-badge" class="ml-3 bg-indigo-50 text-indigo-700 text-xs font-bold px-2.5 py-1 rounded-full border border-indigo-100">
                    @Model.Enterprises?.Count
                </span>
            </p>
        </div>

        <button onclick="openModal('createModal')" class="mt-4 md:mt-0 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-lg text-sm shadow-sm transition-colors focus:outline-none">
            + Добавить предприятие
        </button>
    </div>

    <div id="recent-enterprises-container" class="hidden w-full max-w-7xl mx-auto mb-4 text-xs text-gray-500 flex items-center space-x-2">
        <span class="font-medium text-gray-400 flex-shrink-0">🕒 Недавние:</span>
        <div id="recent-enterprises-list" class="flex flex-nowrap items-center gap-2 overflow-x-auto w-full py-1" style="-ms-overflow-style: none; scrollbar-width: none;">
            @* недавние предприятия 3 максимум *@
        </div>
    </div>





    <div class="flex flex-wrap -mx-4">

        @if (Model.Enterprises != null && Model.Enterprises.Any())
        {
            @foreach (var enterprise in Model.Enterprises)
            {
                <div class="w-full sm:w-1/2 lg:w-1/3 px-4 mb-6 flex">
                    <div id="enterprise-card-@enterprise.Id" class="enterprise-card-item bg-white rounded-xl shadow-sm border border-gray-200 transition-all ease-in-out hover:border-indigo-400 p-4 flex flex-col justify-between w-full hover:shadow-md transition-shadow duration-500">

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">

                            <div class="space-y-2 border-r border-gray-100 pr-2">
                                <div class="enterprise-hosts-ips hidden" style="display: none !important;">
                                    @foreach(var host in enterprise.Hosts)
                                    {
                                        @host.Ip @(" ")
                                    }
                                </div>
                                <div class="relative group cursor-help flex justify-between items-start mb-1">
                                    <h2 class="enterprise-name-text text-base font-semibold text-gray-800 line-clamp-1">@enterprise.Name</h2>

                                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        
                                    <div class="max-h-36 overflow-y-auto bg-gray-900 dark:bg-gray-700 text-white text-[11px] p-2.5 rounded-lg shadow-xl whitespace-normal break-words border border-gray-700 dark:border-gray-600">
                                        @enterprise.Name
                                    </div>
        
                                    <div class="absolute top-[calc(100%-8px)] left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                                </div>
                                </div>
                                <div class="relative group cursor-help flex items-center text-gray-600">
                                    <span class="font-medium text-gray-400 w-16 flex-shrink-0">📍 Город:</span>
                                    <span class="enterprise-city-text text-gray-800 truncate">@enterprise.City?.Name</span>

                                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        
                                    <div class="max-h-36 overflow-y-auto bg-gray-900 dark:bg-gray-700 text-white text-[11px] p-2.5 rounded-lg shadow-xl whitespace-normal break-words border border-gray-700 dark:border-gray-600">
                                        @enterprise.City?.Name
                                    </div>
        
                                    <div class="absolute top-[calc(100%-8px)] left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                                </div>
                                </div>
                                <div class="relative group cursor-help flex items-center text-gray-600">
                                    <span class="font-medium text-gray-400 w-16 flex-shrink-0">📱 Контакт:</span>
                                    <span class="enterprise-contact-text text-gray-800 truncate">@enterprise.Contact</span>

                                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        
                                    <div class="max-h-36 overflow-y-auto bg-gray-900 dark:bg-gray-700 text-white text-[11px] p-2.5 rounded-lg shadow-xl whitespace-normal break-words border border-gray-700 dark:border-gray-600">
                                        @enterprise.Contact
                                    </div>
        
                                    <div class="absolute top-[calc(100%-8px)] left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                                </div>
                                </div>
                            </div>

                            <div class="relative group cursor-help flex flex-col justify-start">
                                <span class="font-medium text-gray-400 mb-1 relative top-[2px]">📝 Заметки:</span>
                                <p class="enterprise-note-text text-gray-600 italic line-clamp-3 text-[11px] leading-relaxed">@enterprise.Note</p>

                                <div class="absolute bottom-full left-1/2 -translate-x-1/2 pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        
                                    <div class="max-h-36 overflow-y-auto bg-gray-900 dark:bg-gray-700 text-white text-[11px] p-2.5 rounded-lg shadow-xl whitespace-normal break-words border border-gray-700 dark:border-gray-600">
                                        @enterprise.Note
                                    </div>
        
                                    <div class="absolute top-[calc(100%-8px)] left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                                </div>
                            </div>

                        </div>

                        <div class="mt-6 pt-4 border-t border-gray-100 flex justify-between items-center">
                            <div class="flex-row items-center">

                            
                            <button type="button" onclick="openUpdateModal(@enterprise.Id, '@enterprise.Name', @enterprise.CityId, '@enterprise.Contact', '@enterprise.Note')" 
                                class="text-gray-400 hover:text-indigo-600 transition-colors p-1 rounded-md hover:bg-indigo-50 focus:outline-none mr-1" 
                                title="Редактировать предприятие">
                                <svg xmlns="http://w3.org" class="h-6 w-6 hover:scale-110" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                            </button>

                            <form method="post" onsubmit="submitDelete(event, @enterprise.Id, '@enterprise.Name')" class="inline">
                                <button type="submit" class="text-gray-400 hover:text-red-600 transition-colors p-1 rounded-md hover:bg-red-50 focus:outline-none" 
                                    title="Удалить предприятие">
                                    <svg xmlns="http://w3.org" class="h-6 w-6 hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </form>
                            </div>
                            <a data-enterprise-id="@enterprise.Id" data-enterprise-name="@enterprise.Name" asp-page="/EnterpriseDetails" asp-route-id="@enterprise.Id" class="inline-flex items-center justify-center px-4 py-2 border
                                border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 
                                focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-150">
                                Открыть →
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="access-item-card w-full px-4 py-12 text-center bg-gray-50 rounded-xl border border-dashed border-gray-300 mx-4">
                <p class="text-gray-500 font-medium">Ничего не найдено</p>
            </div>
        }
        <div id="no-results-message" class="hidden w-full max-w-7xl mx-auto px-4 py-12 text-center">
            <div class="text-4xl mb-3">🔍</div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Ничего не найдено</h3>
        </div>
    </div>
</div>




<div id="createModal" onclick="checkOverlayClose(event, 'createModal', true)" class="@(ViewData["OpenCreateModal"] != null ? "flex" : "hidden") fixed inset-0 bg-gray-900/40 backdrop-blur-sm items-end md:items-center justify-center z-50 transition-opacity duration-300 p-0 md:p-4 opacity-0">

    
    <div class="bg-white rounded-t-2xl md:rounded-xl shadow-xl border border-gray-200 p-6 max-w-md w-full relative transition-transform duration-300 translate-y-0 max-h-[92vh] overflow-y-auto">
        
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto mb-4 md:hidden"></div>

        <button type="button" onclick="closeModal('createModal', true)" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg focus:outline-none">&times;</button>
        
        <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Новое предприятие</h3>

        <div id="enterpriseErrorSummary" class="hidden text-red-600 font-semibold bg-red-50 p-3 rounded-lg mb-3 border border-red-100 text-xs"></div>

        <form method="post" asp-page-handler="Create" id="ajaxEnterpriseForm" onsubmit="submitEnterpriseForm(event)" class="space-y-4">
            <div id="enterpriseErrorSummary" class="hidden text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-lg mb-4 border border-red-100"></div>
            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Название</label>
                <input id="NewEnterprise_Name" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Новое предприятие" />
                <span class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Город</label>
                <div class="flex space-x-2 w-full">
                    <div class="relative w-full custom-select-container">

                        <input id="NewEnterprise_CityId" type="hidden" name="NewEnterprise.CityId" class="custom-select-value" required value="" />

                        <div class="custom-select-trigger relative w-full bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg pl-3 pr-10 py-2 text-sm text-gray-900 dark:text-white flex items-center justify-between cursor-pointer select-none transition-all duration-200 focus:outline-none">
                            <span class="custom-select-text text-gray-400 dark:text-gray-400">-- Выберите город --</span>
                            <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="custom-select-arrow w-4 h-4 text-gray-400 transition-transform duration-200">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                        </div>


                        <div class="custom-select-options hidden absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl z-50 transition-all duration-200">
                        @if (Model.CityList != null && Model.CityList.Any())
                        {    
                            @foreach (var item in Model.CityList)
                            {
                                <div data-value="@item.Value" class="custom-select-option px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-indigo-50 dark:hover:bg-gray-700 hover:text-indigo-600 dark:hover:text-white cursor-pointer select-none transition-colors">
                                    @item.Text
                                </div>
                            }
                        }
                        else
                        {
                            <div class="px-4 py-2 text-sm text-gray-400 dark:text-gray-500 italic select-none">
                                Нет доступных городов
                            </div>
                        }
                        </div>
                    </div>
    
                    <button type="button" onclick="openModal('cityModal')" class="bg-gray-100 hover:bg-gray-200 border border-gray-300 text-gray-700 px-3 rounded-lg text-sm focus:outline-none transition-colors" title="Добавить новый город">+</button>
                </div>
                <span class="text-red-500 text-xs mt-1 block"></span>


                

            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Контакты</label>
                <input id="NewEnterprise_Contact" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="ФИО, телефон" />
                <span class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Примечание</label>
                <textarea id="NewEnterprise_Note" rows="2" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="Дополнительно..."></textarea>
            </div>

            <div class="pt-2 flex space-x-3">
                <button type="button" onclick="closeModal('createModal', true)" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 rounded-lg text-sm transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg text-sm shadow-sm transition-colors">Создать</button>
            </div>
        </form>
    </div>
</div>




<div id="updateModal" onclick="checkOverlayClose(event, 'updateModal', true)" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm items-end md:items-center justify-center z-50 transition-opacity duration-300 p-0 md:p-4 opacity-0">
    
    <div class="bg-white rounded-t-2xl md:rounded-xl shadow-xl border border-gray-200 p-6 max-w-md w-full relative transition-transform duration-300 translate-y-full md:scale-95 max-h-[92vh] overflow-y-auto">
        
        <div class="w-12 h-1.5 bg-gray-300 rounded-full mx-auto mb-4 md:hidden"></div>
        <button type="button" onclick="closeModal('updateModal', true)" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-lg focus:outline-none">&times;</button>
        
        <h3 class="text-lg font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">Редактировать предприятие</h3>

        <div id="editEnterpriseErrorSummary" class="hidden text-red-600 font-semibold bg-red-50 p-3 rounded-lg mb-3 border border-red-100 text-xs"></div>


        <form method="post" asp-page-handler="Update" id="ajaxUpdateForm" onsubmit="submitUpdateForm(event)" class="space-y-4">
            <div id="updateErrorSummary" class="hidden text-red-600 text-xs font-semibold bg-red-50 p-3 rounded-lg mb-4 border border-red-100"></div>
            <input type="hidden" id="updateId" />

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Название</label>
                <input id="updateName" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Город</label>

                <div class="relative w-full custom-select-container">

                    <input type="hidden" id="updateCityId" name="CityId" class="custom-select-value" required value="" />

                    <div class="custom-select-trigger w-full bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg pl-3 pr-10 py-2 text-sm text-gray-900 dark:text-white flex items-center justify-between cursor-pointer select-none transition-all duration-200 focus:outline-none">
                        <span class="custom-select-text text-gray-400 dark:text-gray-400">-- Выберите город --</span>
                        <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="custom-select-arrow w-4 h-4 text-gray-400 transition-transform duration-200">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                        </svg>
                    </div>

                    <div class="custom-select-options hidden absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl z-50 transition-all duration-200">
                    @if (Model.CityList != null && Model.CityList.Any())
                    {
                        @foreach(var item in Model.CityList)
                        {
                        <div data-value="@item.Value" class="custom-select-option px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-indigo-50 dark:hover:bg-gray-700 hover:text-indigo-600 dark:hover:text-white cursor-pointer select-none transition-colors">
                            @item.Text
                        </div>
                        }
                    }
                    else
                    {
                    <div class="px-4 py-2 text-sm text-gray-400 dark:text-gray-500 italic select-none">
                        Нет доступных городов
                    </div>
                    }
                </div>
            </div>

            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Контакты</label>
                <input id="updateContact" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                <span class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">Примечание</label>
                <textarea id="updateNote" rows="2" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
            </div>

            <div class="pt-2 flex space-x-3">
                <button type="button" onclick="closeModal('updateModal', true)" class="w-1/2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 rounded-lg text-sm transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 rounded-lg text-sm shadow-sm transition-colors">Сохранить</button>
            </div>
        </form>
    </div>
</div>




<div id="cityModal" class="hidden fixed inset-0 bg-gray-950/20 backdrop-blur-xs items-center justify-center z-50 p-4 opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-5 max-w-xs w-full relative transition-transform duration-300 scale-95">
        <h4 class="text-sm font-bold text-gray-900 mb-3">Новый город в справочник</h4>
        <form method="post" asp-page-handler="CreateCity" id="ajaxCityForm" onsubmit="submitCityForm(event)">
            <input type="text" id="cityNameInput" required class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none mb-3" placeholder="Например, Самара" />
            <div class="flex space-x-2">
                <button type="button" onclick="closeModal('cityModal')" class="w-1/2 bg-gray-50 hover:bg-gray-100 text-gray-600 text-xs py-2 rounded-lg transition-colors">Отмена</button>
                <button type="submit" class="w-1/2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs py-2 rounded-lg shadow-sm transition-colors">Добавить</button>
            </div>
        </form>
    </div>
</div>



<style>
.max-h-36::-webkit-scrollbar {
    width: 4px;
}
.max-h-36::-webkit-scrollbar-thumb {
    background-color: #4b5563;
    border-radius: 2px;
}
</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/index.js" asp-append-version="true"></script>
}
