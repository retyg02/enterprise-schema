                                        @(string.IsNullOrWhiteSpace(host.OsType) ? "00" : host.OsType)
                                    </span>
                                                            <span data-copy-green class="ml-auto text-slate-400 dark:text-slate-500 italic">
                                        Назначение: @(string.IsNullOrWhiteSpace(host.Purpose) ? "Общее" : host.Purpose)
                                    </span>
                                </div>

                                @if (host.Accesses != null && host.Accesses.Any())
                                {
                                    <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800 space-y-1.5">
                                        @foreach (var access in host.Accesses)
                                        {
                                            var socketString = $"{access.Address}:{access.Port}";
                                            var rawPassword = EnterpriseSchema.Data.CryptoHelper.Decrypt(access.Pass);

                                            <div class="bg-slate-50 dark:bg-slate-900 rounded-lg p-2 text-[11px] border border-slate-100 dark:border-slate-800 space-y-1">
                                                <div class="flex items-center justify-between">
