whitespace-normal break-words border border-gray-700 dark:border-gray-600">

                                    


                                        @enterprise.Name
                                    </div>
        
                                    <div class="absolute top-[calc(100%-8px)] left-4 border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                                </div>
                                </div>
                                <div class="relative group flex items-center text-gray-600">
                                    <span class="font-medium text-gray-400 w-20 flex-shrink-0 flex flex-row">
