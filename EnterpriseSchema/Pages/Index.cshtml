@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container mx-auto px-4 py-8">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b border-gray-200 pb-6 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Реестр развертываний</h1>
            <p class="text-sm text-gray-500 mt-1">Список подключенных предприятий</p>
        </div>
    </div>

    <div class="flex flex-wrap -mx-4">

        @if (Model.Enterprises != null && Model.Enterprises.Any())
        {
            @foreach (var enterprise in Model.Enterprises)
            {
                <div class="w-full sm:w-1/2 lg:w-1/3 px-4 mb-6 flex">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 flex flex-col justify-between w-full hover:shadow-md transition-shadow duration-200">

                        <div>
                            <div class="flex justify-between items-start mb-4">
                                <h2 class="text-xl font-semibold text-gray-800">@enterprise.Name</h2>
                            </div>

                            <div class="space-y-3 text-sm text-gray-600">
                                <div class="flex items-center">
                                    <span class="font-medium text-gray-400 w-24 flex-shrink-0">📍 Город:</span>
                                    <span class="text-gray-900">@enterprise.City</span>
                                </div>
                                <div class="flex items-start">
                                    <span class="font-medium text-gray-400 w-24 flex-shrink-0">👤 Контакт:</span>
                                    <span class="text-gray-900">@enterprise.Contact</span>
                                </div>
                                <div class="flex flex-col mt-2 pt-2 border-t border-gray-100">
                                    <span class="font-medium text-gray-400 mb-1">📝 Заметки:</span>
                                    <p class="text-gray-600 text-xs italic line-clamp-2">@enterprise.Note</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 pt-4 border-t border-gray-100 flex justify-end">
                            <a asp-page="/EnterpriseDetails" asp-route-id="@enterprise.Id" class="inline-flex items-center justify-center px-4 py-2 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-150">
                                Открыть →
                            </a>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="w-full px-4 py-12 text-center bg-gray-50 rounded-xl border border-dashed border-gray-300 mx-4">
                <p class="text-gray-500 font-medium">Ничего не найдено</p>
            </div>
        }

    </div>
</div>
