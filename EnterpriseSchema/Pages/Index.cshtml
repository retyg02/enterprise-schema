                                                            ••••••••
                                                        </span>
                                                        <button type="button" class="btn-toggle-password p-0.5 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 focus:outline-none transition-colors" title="Показать/скрыть пароль">
                                                            <svg xmlns="http://w3.org" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" id="eye-icon-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.024 10.024 0 014.13-5.24M7.42 7.42L16.6 16.6M9.88 9.88a3 3 0 104.24 4.24M10.804 5.204A10.015 10.015 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.24M3 3l18 18"></path></svg>
                                                        </button>
                                                    </div>
                                                </div>
                                                @if (access.AttachedFiles != null && access.AttachedFiles.Any())
                                                {
                                                    <div class="flex flex-wrap gap-1.5 mt-2 pt-1.5 border-t border-dashed border-slate-200 dark:border-slate-700">
                                                        @foreach (var file in access.AttachedFiles)
                                                        {
                                                            <a href="/uploads/@file.StoredFileName" 
                                                                download="@file.FileName" 
                                                                class="custom-file-pill inline-flex items-center gap-1 px-2 py-0.5 text-[10px] rounded border transition-colors decoration-none font-medium">
                                                                    📎 @file.FileName
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-[11px] text-slate-400 dark:text-slate-500 text-center py-4 border border-dashed border-slate-200 dark:border-slate-800 rounded-xl">
                        Инфраструктура хостов отсутствует
                    </p>
                }
            </div>

            <div class="space-y-2 pt-2 border-slate-100 dark:border-slate-800">
                <h4 class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Заметки</h4>
                                        <div data-copy-green class="bg-amber-50/40 dark:bg-amber-950/10 rounded-xl p-3 border border-amber-100/60 dark:border-amber-900/30 text-xs leading-relaxed text-slate-700 dark:text-slate-300">
                    @(string.IsNullOrWhiteSpace(enterprise.Note) ? "Здесь ничего нет" : enterprise.Note)
                </div>
            </div>
        </div> 

        <div class="mt-auto border-t border-slate-100 dark:border-slate-800 py-3 w-full shrink-0">
            <p class="text-[10px] text-slate-400 dark:text-slate-500 text-left">
                Изменено: @enterprise.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")
            </p>
        </div>

    </div>
</div>








