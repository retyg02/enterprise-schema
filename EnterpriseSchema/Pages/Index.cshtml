                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                        </svg>
                                        Город:</span>
                                    <span class="enterprise-city-text text-gray-800 truncate">@enterprise.City?.Name</span>

                                    <div class="z-[100] absolute bottom-full left-0 pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 
transition-opacity duration-300">
        
                                    <div class="z-100 relative max-h-36 overflow-y-auto bg-gray-900 dark:bg-gray-700 text-white text-[11px] p-2.5 rounded-lg shadow-xl 
whitespace-normal break-words border border-gray-700 dark:border-gray-600">
                                        @enterprise.City?.Name
                                    </div>
        
                                    <div class="absolute top-[calc(100%-8px)] left-4 border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                                </div>
                                </div>
                                <div class="relative group flex items-center text-gray-600">
                                    <span class="font-medium text-gray-400 w-20 flex-shrink-0 flex flex-row">
                                        <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mr-[5px] w-3.5 h-3.5 text-slate-400">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-1.514 2.018a14.977 14.977 0 0 1-6.577-6.577l2.018-1.514c.362-.272.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                            </svg>
                                        Контакт:</span>
                                    <span class="enterprise-contact-text text-gray-800 truncate">@enterprise.Contact</span>

                                    <div class="z-[100] absolute bottom-full left-0 pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 transition-opacity 
duration-300">
        
