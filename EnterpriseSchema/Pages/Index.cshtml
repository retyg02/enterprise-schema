                <p class="enterprise-note-text text-gray-600 dark:text-gray-400 italic line-clamp-3 text-[11px] leading-relaxed">@enterprise.Note</p>
                
                
                <div class="z-[100] absolute bottom-full right-0 left-auto pb-2 hidden group-hover:block w-56 z-30 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="z-100 relative max-h-36 overflow-y-auto bg-gray-900 dark:bg-gray-700 text-white text-[11px] p-2.5 rounded-lg shadow-xl whitespace-normal 
break-words border border-gray-700 dark:border-gray-600">
                        @enterprise.Note
                    </div>
                    <div class="absolute top-[calc(100%-8px)] right-4 left-auto border-4 border-transparent border-t-gray-900 dark:border-t-gray-700"></div>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col justify-start mt-2 text-[11px] text-gray-400 dark:text-gray-600">
                <span class="relative top-[-5px]">Нет заметок</span>
            </div>
        }

                        </div>

                        <div class="mt-6 pt-4 border-t border-gray-100 flex justify-between items-center">
                            <div class="flex-row items-center">

                            
