                                                    <span data-copy-target="@socketString"
                                                          class="js-clickable-copy text-slate-500 font-mono cursor-pointer hover:text-indigo-600 dark:hover:text-indigo-400 rounded px-1 transition-all"
                                                          title="Скопировать сокет">
                                                        @socketString
