            <div id="enterprise-card-@enterprise.Id" data-city-id="@enterprise.City?.Id" class="view-card enterprise-card-item bg-white dark:bg-gray-900 border 
border-gray-200 dark:border-gray-800 rounded-xl p-4 flex flex-col justify-between w-full shadow-sm hover:shadow-md hover:border-indigo-400 dark:hover:border-indigo-500 
transition-all ease-in-out duration-200 text-gray-900 dark:text-white">

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">

                            <div class="space-y-2 border-r border-gray-100 pr-2">
                                <div class="enterprise-hosts-ips hidden" style="display: none !important;">
