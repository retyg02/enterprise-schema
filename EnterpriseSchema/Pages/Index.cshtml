                                    </div>
                                    <span data-copy-target="@host.Ip"
                                          class="js-clickable-copy font-mono text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 px-1.5 py-0.5 rounded cursor-pointer hover:bg-indigo-500 hover:text-white transition-all duration-200"
